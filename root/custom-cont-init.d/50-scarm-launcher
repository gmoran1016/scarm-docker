#!/bin/bash
# LinuxServer's KasmVNC base seeds /config/.config/openbox/autostart from
# /defaults/autostart ONCE, then never refreshes it. That means launcher fixes
# shipped in newer images are silently ignored on existing installs (the stale
# /config copy keeps running). Force-sync the current launcher on every start so
# the image is always the source of truth.
mkdir -p /config/.config/openbox
cp /defaults/autostart /config/.config/openbox/autostart
chmod 755 /config/.config/openbox/autostart
chown abc:abc /config/.config/openbox/autostart 2>/dev/null || true
