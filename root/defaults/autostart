#!/usr/bin/env bash
# scarm-docker autostart — runs as user 'abc' inside the KasmVNC desktop (HOME=/config).
# Replaces the base image's default xterm autostart.

export WINEPREFIX="${WINEPREFIX:-/config/wine}"
export WINEARCH="${WINEARCH:-win64}"
export WINEDEBUG="${WINEDEBUG:--all}"
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-mscoree,mshtml=}"

INSTALLER="/opt/SCARMsetup.exe"

find_scarm() { find "$WINEPREFIX/drive_c" -iname 'SCARM.exe' 2>/dev/null | head -n1; }

# Install on first run (or retry if a previous install failed). The presence of
# SCARM.exe is the idempotency guard, so a failed install just retries next start.
SCARM_EXE="$(find_scarm)"
if [ -z "$SCARM_EXE" ]; then
    echo "[scarm] First run: initializing Wine prefix at $WINEPREFIX and installing SCARM ..."
    wineboot --init || true
    wineserver -w || true
    echo "[scarm] Installing SCARM (silent) ..."
    wine "$INSTALLER" /VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP- || true
    wineserver -w || true
    SCARM_EXE="$(find_scarm)"
fi

# Expose the /projects host folder as Wine drive P: for saving/opening layouts.
mkdir -p /projects
[ -d "$WINEPREFIX/dosdevices" ] && ln -sfn /projects "$WINEPREFIX/dosdevices/p:"

if [ -z "$SCARM_EXE" ]; then
    echo "[scarm] ERROR: SCARM.exe not found after install attempt." >&2
    echo "[scarm] The silent install may have failed under Wine; see the README" >&2
    echo "[scarm] troubleshooting section for the interactive-install fallback." >&2
    # Keep the desktop usable (and logs visible) instead of leaving it blank.
    exec xterm -e "echo 'SCARM install failed. Check container logs and the README.'; exec bash"
fi

echo "[scarm] Launching: $SCARM_EXE"
# Relaunch if the user closes SCARM, so the desktop isn't left empty.
while true; do
    wine "$SCARM_EXE" || true
    sleep 2
done
